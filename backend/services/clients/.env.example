# Configuración local de demostración. Los secretos se generan con scripts/prepare.py.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=clients
DB_USER=clients_app
DB_PASS_FILE=backend/.runtime/clients_db_password
INTERNAL_GATEWAY_SECRET_FILE=backend/.runtime/clients_gateway_secret
DEMO_MODE=true
AUTH_SERVICE_URL=http://127.0.0.1:8100
CLIENTS_AUTH_SECRET_FILE=backend/.runtime/clients_auth_secret
ORDERS_CLIENTS_SECRET_FILE=backend/.runtime/orders_clients_secret
