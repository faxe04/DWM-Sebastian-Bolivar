# Desarrollo local: configurar claves coincidentes con cada servicio.
# No incluir valores reales en este ejemplo. El gateway ya no consulta Vault.
# Compose conserva la configuracion anterior y necesita adaptarse por separado.
AUTH_SERVICE_URL=http://localhost:8100
INVENTORY_URL=http://localhost:9000
ORDERS_URL=http://localhost:9100
CLIENTS_URL=http://localhost:9200
PAYMENTS_URL=http://localhost:9300
GRAPHQL_URL=http://localhost:9400

VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=vault_token
